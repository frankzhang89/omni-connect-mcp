<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>xyz.fz</groupId>
        <artifactId>omni-connect-mcp</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>omni-connect-app</artifactId>
    <dependencies>
        <dependency>
            <groupId>xyz.fz</groupId>
            <artifactId>omni-connect-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>xyz.fz</groupId>
            <artifactId>omni-connect-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>xyz.fz</groupId>
            <artifactId>omni-connect-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>xyz.fz</groupId>
            <artifactId>omni-connect-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>omni-connect-mcp</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>xyz.fz.omni.app.OmniConnectApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>stage-release</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${base.export.path}/omni-connect-mcp"/>
                                <copy file="${project.build.directory}/omni-connect-mcp.jar" todir="${base.export.path}/omni-connect-mcp"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
